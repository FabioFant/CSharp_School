<Window x:Class="Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Client"
        mc:Ignorable="d"
        Title="Client TCP" Height="600" Width="600" ResizeMode="NoResize">
    <Grid>
        <Label x:Name="lbl_tcpClient" Content="TCP-CLIENT" HorizontalAlignment="Left" Margin="79,56,0,0" VerticalAlignment="Top" FontFamily="Cascadia Mono SemiBold" FontSize="36"/>
        <Button x:Name="btn_start" Content="Start" HorizontalAlignment="Left" Margin="390,56,0,0" VerticalAlignment="Top" Height="52" Width="124" FontFamily="Cascadia Code" FontSize="22" RenderTransformOrigin="-0.665,9.265" Click="btn_start_Click"/>
        <Label x:Name="lbl_server" Content="Server:" HorizontalAlignment="Left" Margin="86,183,0,0" VerticalAlignment="Top" FontFamily="Cascadia Mono SemiBold" FontSize="20" Height="29" Width="153"/>
        <TextBox x:Name="tbox_messaggio" HorizontalAlignment="Center" Margin="0,354,0,0" TextWrapping="Wrap" Text="Ciao Server!" VerticalAlignment="Top" Width="428" Height="114" FontSize="18" FontFamily="Cascadia Code"/>
        <Button x:Name="btn_invia" Content="Invia messaggio" HorizontalAlignment="Center" Margin="0,473,0,0" VerticalAlignment="Top" Height="52" Width="212" FontFamily="Cascadia Code" FontSize="22" Click="btn_invia_Click" IsEnabled="False"/>
        <TextBox x:Name="tbox_risposta" HorizontalAlignment="Center" Margin="0,217,0,0" TextWrapping="Wrap" Text="Qui vedrai il messaggio inviato dal server." VerticalAlignment="Top" Width="428" Height="114" FontSize="18" FontFamily="Cascadia Code" Background="#FFC7C7C7" BorderBrush="#FFC7C7C7" IsEnabled="False"/>
        <TextBox x:Name="tbox_eccezione" HorizontalAlignment="Center" Margin="0,113,0,0" TextWrapping="Wrap" Text="Eccezione" VerticalAlignment="Top" Width="428" Height="70" FontFamily="Cascadia Code" IsEnabled="False" Foreground="Black" BorderBrush="White" Background="White"/>

    </Grid>
</Window>
