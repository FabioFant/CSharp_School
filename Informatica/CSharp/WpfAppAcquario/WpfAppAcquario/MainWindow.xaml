<Window x:Class="WpfAppAcquario.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfAppAcquario"
        mc:Ignorable="d"
        Title="Acquario" Height="450" Width="800" ResizeMode="NoResize">
    <Grid HorizontalAlignment="Center" Width="800" Height="434" VerticalAlignment="Bottom">
        <Canvas x:Name="canvasAcquario" Height="434" Width="800" ClipToBounds="True">
            <Canvas.Background>
                <ImageBrush ImageSource="/Immagini/bg.png"/>
            </Canvas.Background>
            <Label x:Name="txt_medusa" Content="Medusa: WASD + SPAZIO" Canvas.Left="10" Canvas.Top="35" HorizontalAlignment="Center" VerticalAlignment="Top" Width="167" FontFamily="Cascadia Code" FontWeight="Bold"/>
            <Label x:Name="txt_medusa_Copia" Content="Pescepalla: Freccette" Canvas.Left="632" Canvas.Top="35" Width="158" FontFamily="Cascadia Code" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top"/>
            <Label x:Name="txt_Intestazione" Content="Fabio Fantini 4H 2024-12-20" Canvas.Left="321" Canvas.Top="35" Width="158" FontFamily="Cascadia Code" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        </Canvas>

    </Grid>
</Window>
