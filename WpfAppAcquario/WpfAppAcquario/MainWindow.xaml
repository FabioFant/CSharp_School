<Window x:Class="WpfAppAcquario.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfAppAcquario"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" ResizeMode="NoResize">
    <Grid HorizontalAlignment="Center" Width="800" Height="434" VerticalAlignment="Bottom">
        <Canvas x:Name="canvasAcquario" Height="400" Width="600" Margin="190,17,10,17">
            <Canvas.Background>
                <ImageBrush ImageSource="/Immagini/background.png"/>
            </Canvas.Background>
        </Canvas>
        <Label x:Name="txtContatore" Content="N.Tick: " HorizontalAlignment="Left" Margin="10,17,0,0" VerticalAlignment="Top" Height="30" Width="80"/>
        <Label x:Name="txtMillSec" Content="Ms: " HorizontalAlignment="Left" Margin="105,17,0,0" VerticalAlignment="Top" Height="30" Width="80"/>
        <Button x:Name="btnTranslate" Content="Traslazione" HorizontalAlignment="Left" Margin="10,85,0,0" VerticalAlignment="Top" Click="btnTranslate_Click" Height="44" Width="175"/>
        <Button x:Name="btn_Rotate" Content="Rotate" HorizontalAlignment="Left" Margin="10,134,0,0" VerticalAlignment="Top" Click="btn_Rotate_Click" Width="175" Height="45"/>
        <Button x:Name="btn_Scale" Content="Scale" HorizontalAlignment="Left" Margin="10,184,0,0" VerticalAlignment="Top" Click="btn_Scale_Click" Width="175" Height="45"/>

    </Grid>
</Window>
